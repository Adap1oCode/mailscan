# Required — shared secret for X-API-Key header auth
MAILSCAN_API_KEY=change-me-to-a-strong-random-string

# Required on Linux/Mac — path to tesseract binary
# Find it with: which tesseract
TESSERACT_CMD=/usr/bin/tesseract

# Optional — HTTP port (default 8000)
PORT=8000

# Optional — Redis URL for async job queue (Celery)
# If not set, /process falls back to synchronous processing
# Format: redis://<host>:<port>/<db>
REDIS_URL=redis://redis:6379/0

# Optional — address parser ('regex' or 'libpostal')
# regex:    lightweight, fast, good for clean scans (default)
# libpostal: ML-based, handles OCR noise, requires libpostal compiled in Docker
ADDRESS_PARSER=regex

# Optional — default page render DPI (default 200). The speed/accuracy sweet spot
# for this pipeline; raise to 300 if OCR on small print suffers. An explicit dpi
# form field on a request overrides this.
MAILSCAN_RENDER_DPI=200

# Optional — ink coverage % below which a page is treated as blank and dropped
# during the split-only step (default 0.6). Removes blank duplex backs and the
# blank back of a single-sided separator sheet. Pixel-based, no OCR.
MAILSCAN_BLANK_INK_PCT=0.6

# Optional — "real marks" floor in ink % (default 0.1; must be < BLANK_INK_PCT).
# Safety net: if every page of a separator-delimited segment is below the blank
# threshold, the densest page is still kept when it clears this floor — so a faint
# single-page letter is never silently dropped, while a true ~0% blank still is.
MAILSCAN_BLANK_KEEP_FLOOR=0.1

# Optional — worker threads for the in-process async job registry used when Redis
# is not configured (default 2). The split step returns a job_id to poll; this
# bounds how many such jobs run at once.
MAILSCAN_INPROC_WORKERS=2

# Optional — cap the longest rendered page side in pixels (default 4500).
# Bounds peak memory per page so very large / high-DPI scans can't OOM the
# container. A4 @ 300 DPI is ~3508px; lower this on small-RAM hosts.
MAILSCAN_MAX_RENDER_PX=4500

# Optional — hard ceiling (ms) for a single full-page Mailmark Data Matrix scan
# (default 1500). A present barcode decodes in <100ms; this only bounds the wasted
# time on barcode-free pages (most pages of a letter), so it dominates OCR latency
# — keep it tight. Raise it only if real Mailmark barcodes are being missed.
MAILSCAN_DMTX_TIMEOUT_MS=1500

# Optional — minimum fuzzy-match score 0–100 for client matching (default 85).
MAILSCAN_MATCH_CUTOFF=85

# Optional — minimum margin (best minus second-best client score) for a match to
# count as unambiguous (default 10). Near-tied candidates → AI/review.
MAILSCAN_MATCH_MARGIN=10

# Optional — minimum recipient-name extraction confidence 0–1 to route on the
# free stack (default 0.6). Below this → AI fallback.
MAILSCAN_NAME_CONF=0.6

# Optional — comma-separated shared/virtual-office postcodes where the recipient
# NAME (not the postcode) routes the mail (default "LU1 2DW").
MAILSCAN_SHARED_POSTCODES=LU1 2DW

# --- AI fallback providers (optional; mock used until keys are set) ---
# AWS Textract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
# Google Gemini
GEMINI_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# Google Document AI
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=eu
# Azure Document Intelligence
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
